# Contact form (/contact) — server-side only. Set these in the hosting
# provider's environment settings (and .env.local for local testing).
# Never prefix with NEXT_PUBLIC_.

# Resend API key with "Sending access".
RESEND_API_KEY=

# Inbox that receives contact-form messages.
CONTACT_TO_EMAIL=

# Sender address on a domain verified in Resend, e.g. "Easli <name@your-domain>".
CONTACT_FROM_EMAIL=
